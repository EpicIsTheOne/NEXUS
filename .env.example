PORT=3000
BASE_PATH=/aichat

# OpenAI-compatible chat backend
BACKEND_BASE_URL=http://127.0.0.1:1234/v1
DEFAULT_MODEL=your-model-id
DEFAULT_PROVIDER_LABEL=local

# Writable app data
APP_DATA_DIR=/app/data
ST_DATA_DIR=/mounted/st-data/default-user
PUBLIC_APP_ORIGIN=https://example.com

# Optional provider keys
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Fish Audio TTS
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
DEFAULT_FISH_REFERENCE_ID=
DEFAULT_FISH_VOICE_LABEL=Default Fish Voice
FISH_TTS_BACKEND=s2-pro
TTS_EMOTION_MODEL=
TTS_EMOTION_TIMEOUT_MS=15000

# Image generation
REPLICATE_API_TOKEN=

# Optional OpenClaw bridge
OPENCLAW_BRIDGE_URL=http://127.0.0.1:3101
OPENCLAW_BRIDGE_SECRET=
OPENCLAW_AUTH_PROFILES_PATH=/openclaw-auth-profiles.json

# TTS cache limits
AUDIO_CACHE_MAX_AGE_DAYS=14
AUDIO_CACHE_MAX_FILES=500
AUDIO_CACHE_MAX_BYTES=536870912
