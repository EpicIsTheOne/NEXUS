# NEXUS / AIChat environment
# Copy to .env, then run: npm run setup:check

# ===== Required basics =====
PORT=3000
BASE_PATH=/nexus
APP_DATA_DIR=./data
PUBLIC_APP_ORIGIN=http://localhost:3000

# Optional local Docker host binding override.
# Useful if port 3000 is already taken on your machine.
HOST_BIND=127.0.0.1
HOST_PORT=3000

# Optional: set a known password before first boot.
# If omitted, the server creates first-run users from its defaults.
DEFAULT_ADMIN_PASSWORD=
# Optional: known password for the secondary seeded admin ("indo").
# If omitted, a random password is generated on first boot (like the
# primary admin). The previously hardcoded "Indorex" default was removed
# when the repo went public to avoid a known credential in source.
INDO_ADMIN_PASSWORD=

# ===== Required for chat responses =====
# Use an OpenAI-compatible /v1 endpoint.
# LM Studio default: http://127.0.0.1:1234/v1
# Ollama OpenAI-compatible default: http://127.0.0.1:11434/v1
BACKEND_BASE_URL=http://127.0.0.1:1234/v1
DEFAULT_MODEL=your-model-id
DEFAULT_PROVIDER_LABEL=local

# ===== Optional SillyTavern-compatible asset mount =====
# Leave blank for a normal local setup.
ST_DATA_DIR=

# ===== Optional provider keys for fallbacks / image generation =====
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# ===== Optional Fish Audio manual TTS =====
# Voice is optional. NEXUS does not need this to chat.
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
DEFAULT_FISH_REFERENCE_ID=
DEFAULT_FISH_VOICE_LABEL=Default Fish Voice
FISH_TTS_BACKEND=s2-pro
TTS_EMOTION_MODEL=
TTS_EMOTION_TIMEOUT_MS=15000

# ===== Optional image generation =====
REPLICATE_API_TOKEN=

# ===== Optional OpenClaw bridge =====
# Only needed for OpenClaw assistant-character routing.
OPENCLAW_BRIDGE_URL=http://127.0.0.1:3101
OPENCLAW_BRIDGE_SECRET=
OPENCLAW_AUTH_PROFILES_PATH=

# ===== Optional TTS cache limits =====
AUDIO_CACHE_MAX_AGE_DAYS=14
AUDIO_CACHE_MAX_FILES=500
AUDIO_CACHE_MAX_BYTES=536870912
