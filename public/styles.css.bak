:root {
  --bg: #0b0d13;
  --panel: #151925;
  --panel-2: #1c2130;
  --panel-3: #0f1320;
  --text: #f4f7fb;
  --muted: #9aa5bc;
  --border: rgba(255, 255, 255, 0.08);
  --accent: #8b5cf6;
  --accent-soft: rgba(139, 92, 246, 0.16);
  --good: #34d399;
  --bad: #f87171;
  --chat-bg-opacity: 0.16;
  --surface-alpha: 0.72;
  --surface-blur: 18px;
  --font-scale: 1;
  --mobile-topbar-height: 56px;
}

* {
  box-sizing: border-box;
}
html,
body {
  height: 100%;
  overscroll-behavior-y: none; /* Prevent pull-to-refresh on mobile */
  /* -webkit-touch-callout: none; */
}
body {
  margin: 0;
  font-family: Inter, system-ui, sans-serif;
  font-size: calc(16px * var(--font-scale));
  color: var(--text);
  overflow: hidden; /* App shell handles scrolling */
  background:
    radial-gradient(
      circle at top left,
      rgba(139, 92, 246, 0.14),
      transparent 28%
    ),
    radial-gradient(
      circle at top right,
      rgba(56, 189, 248, 0.08),
      transparent 22%
    ),
    linear-gradient(180deg, #0b0d13, #111522 60%, #0d1018);
}
.auth-screen {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
}
.auth-card {
  width: min(460px, 100%);
  border: 1px solid var(--border);
  border-radius: 28px;
  background: linear-gradient(
    180deg,
    rgba(27, 32, 45, 0.94),
    rgba(18, 22, 33, 0.94)
  );
  box-shadow: 0 28px 70px rgba(0, 0, 0, 0.42);
  padding: 28px;
  backdrop-filter: blur(calc(var(--surface-blur) + 6px));
}
.auth-card h1 {
  margin: 0 0 10px;
}
.auth-card p {
  color: var(--muted);
  margin: 0 0 18px;
}
.auth-actions {
  justify-content: stretch;
}
.auth-actions button {
  width: 100%;
}
.auth-user-chip {
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 10px 12px;
  background: rgba(255, 255, 255, 0.035);
  color: var(--muted);
}
.filter-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 10px;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 8px;
}
.score-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 34px;
  padding: 4px 8px;
  border-radius: 999px;
  background: rgba(139, 92, 246, 0.18);
  border: 1px solid rgba(139, 92, 246, 0.35);
  color: #d8c8ff;
  font-size: 0.76rem;
  font-weight: 700;
}
.card-meta-row {
  display: flex;
  gap: 6px;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8px;
  color: var(--muted);
  font-size: 0.78rem;
}
.tag-chip {
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 2px 7px;
  background: rgba(255, 255, 255, 0.035);
}
.featured-card .desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.tab-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}
.tab-chip {
  border-radius: 999px;
  padding: 8px 12px;
  background: rgba(255, 255, 255, 0.04);
  color: var(--muted);
}
.tab-chip.active {
  background: rgba(139, 92, 246, 0.18);
  color: var(--text);
  border-color: rgba(139, 92, 246, 0.35);
}
.card-actions-inline {
  display: flex;
  align-items: center;
  gap: 8px;
}
.hover-preview {
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.04);
  color: var(--muted);
  font-size: 0.82rem;
  line-height: 1.35;
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transform: translateY(4px);
  transition:
    opacity 0.18s ease,
    transform 0.18s ease,
    max-height 0.18s ease;
}
.character-card:hover .hover-preview {
  opacity: 1;
  max-height: 130px;
  transform: translateY(0);
}
.character-card:hover {
  transform: translateY(-2px) scale(1.01);
}
.tag-chip.active {
  background: rgba(139, 92, 246, 0.18);
  border-color: rgba(139, 92, 246, 0.35);
  color: var(--text);
}
.character-card.tier-elite {
  border-color: rgba(255, 255, 255, 0.12);
  box-shadow:
    0 12px 38px rgba(139, 92, 246, 0.22),
    0 0 0 1px rgba(56, 189, 248, 0.12) inset;
  background-image: linear-gradient(
    135deg,
    rgba(139, 92, 246, 0.08),
    rgba(56, 189, 248, 0.06)
  );
}
.character-card.tier-high {
  border-color: rgba(139, 92, 246, 0.28);
}
.character-card.tier-low {
  opacity: 0.82;
}
.score-badge.tier-elite {
  background: linear-gradient(
    135deg,
    rgba(139, 92, 246, 0.24),
    rgba(56, 189, 248, 0.22)
  );
  border-color: rgba(125, 211, 252, 0.4);
}
.score-badge.tier-high {
  background: rgba(34, 197, 94, 0.14);
  border-color: rgba(34, 197, 94, 0.3);
  color: #d9ffe7;
}
.score-badge.tier-mid {
  background: rgba(148, 163, 184, 0.14);
  border-color: rgba(148, 163, 184, 0.26);
  color: #e7edf9;
}
.score-badge.tier-low {
  background: rgba(248, 113, 113, 0.12);
  border-color: rgba(248, 113, 113, 0.22);
  color: #ffdede;
}
button,
input,
select,
textarea {
  font: inherit;
}
button {
  cursor: pointer;
  transition:
    transform 0.18s ease,
    background 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    opacity 0.18s ease;
}
button:hover {
  transform: translateY(-1px);
}
.hidden {
  display: none !important;
}
.mobile-only {
  display: none;
}
.eyebrow {
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.72rem;
  margin-bottom: 6px;
}
.mini-label {
  color: var(--muted);
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 6px;
}
.clamp-2,
.clamp-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.clamp-2 {
  -webkit-line-clamp: 2;
}
.clamp-3 {
  -webkit-line-clamp: 3;
}

.app-shell {
  display: grid;
  grid-template-columns: 300px minmax(0, 1fr) 380px;
  height: 100dvh;
  min-height: 100vh;
  overflow: hidden;
}
.app-shell:not(.panel-open) {
  grid-template-columns: 300px minmax(0, 1fr) 0;
}
.library-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(5, 8, 14, 0.66);
  
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s ease;
  z-index: 30;
}
.app-shell.library-open .library-backdrop {
  opacity: 1;
  pointer-events: auto;
}

.sidebar,
.character-panel,
.topbar,
.composer,
.profile-menu,
dialog,
.info-card,
.character-card,
.recent-card,
.message.assistant,
.message.system,
select,
textarea,
input,
.profile-button,
.menu-item,
#new-chat,
#send-btn,
#close-settings,
.icon-button,
.conversation-item,
.bg-option,
.mini-btn,
.tab-chip {
  border: 1px solid var(--border);
  box-shadow: 0 10px 32px rgba(0, 0, 0, 0.18);
}

.sidebar {
  background: rgba(11, 14, 22, var(--surface-alpha));
  backdrop-filter: blur(var(--surface-blur));
  padding: 22px 22px 30px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  overflow-y: auto;
}
.left-sidebar {
  position: relative;
  inset: auto;
  width: auto;
  z-index: 20;
  transform: none;
  transition: transform 0.22s ease;
}
.app-shell.library-open .left-sidebar {
  transform: none;
}
.main-panel {
  grid-column: 2;
}
.character-panel {
  grid-column: 3;
  z-index: 20;
}
.app-shell.library-open .main-panel,
.app-shell.library-open .floating-profile-wrap,
.app-shell.library-open .drawer-handle,
.app-shell.library-open .character-panel {
  filter: none;
  pointer-events: auto;
}

.brand-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.sidebar-header {
  position: sticky;
  top: 0;
  z-index: 2;
  background: rgba(11, 14, 22, 0.94);
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
}
.sidebar-header h1 {
  margin: 0;
  font-size: 1.28rem;
}
.sidebar-header p {
  margin: 8px 0 14px;
  color: var(--muted);
  font-size: 0.95rem;
  line-height: 1.4;
}
.sidebar-header input {
  width: 100%;
  padding: 12px 14px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.03);
  color: var(--text);
}
.sidebar-block {
  display: flex;
  flex-direction: column;
  min-height: initial;
  overflow: visible;
}
.sidebar-section-label {
  margin: 2px 2px 10px;
  color: var(--muted);
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.11em;
}
.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.section-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
.mini-select {
  min-width: 130px;
}
.mini-input {
  border: 1px solid var(--border);
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.72);
  color: var(--text);
  padding: 9px 10px;
  font: inherit;
}
.acquire-count-input {
  width: 76px;
}
.helper-text {
  margin: -2px 2px 10px;
  color: var(--muted);
  font-size: 0.78rem;
  line-height: 1.35;
}
.rejection-summary {
  margin: -4px 2px 10px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.52);
  color: var(--muted);
  font-size: 0.78rem;
  overflow: hidden;
}
.rejection-summary summary {
  cursor: pointer;
  padding: 9px 11px;
  color: var(--text);
  font-weight: 700;
}
.rejection-summary-list {
  display: grid;
  gap: 1px;
  padding: 0 10px 10px;
}
.rejection-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 7px 0;
  border-top: 1px solid rgba(148, 163, 184, 0.16);
}
.rejection-summary-row strong {
  color: var(--text);
  font-variant-numeric: tabular-nums;
}
.library-hub {
  position: absolute;
  inset: 0;
  z-index: 5;
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 18px 22px 18px;
  background: rgba(11, 14, 22, 0.94);
  backdrop-filter: blur(var(--surface-blur));
  overflow-y: auto;
}
.app-shell.library-collapsed .library-hub {
  display: none;
}
/* Library overlay already covers the main panel; do not hide the composer/chat
   via visibility toggles, because that can leave mobile controls disappearing
   if library state gets out of sync. */
.library-hub-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}
.library-hub h1 {
  margin: 0;
  font-size: 1.28rem;
}
.library-hub p {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 0.95rem;
  line-height: 1.4;
}
.library-stack {
  display: flex;
  flex-direction: column;
  gap: 14px;
  flex: 1;
  min-height: 0;
}
.library-strip-block {
  display: flex;
  flex-direction: column;
}
.library-strip-block:last-child {
  flex: 1;
  min-height: 0;
}
.recent-sidebar {
  border-right: 1px solid var(--border);
}
.recent-sidebar-block {
  min-height: 0;
  flex: 1;
}
.compact-sidebar-header p {
  margin-bottom: 0;
}
.recent-list {
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-height: 0;
}
.character-list {
  display: grid;
  gap: 12px;
}
.horizontal-strip {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(280px, 320px);
  gap: 12px;
  overflow-x: auto;
  overflow-y: hidden;
  padding-bottom: 8px;
  scroll-snap-type: x proximity;
  -webkit-overflow-scrolling: touch;
}
#character-list.horizontal-strip {
  grid-auto-flow: row;
  grid-auto-columns: unset;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  overflow-x: hidden;
  overflow-y: auto;
  align-content: start;
  padding-right: 4px;
  scroll-snap-type: none;
  -webkit-overflow-scrolling: touch;
}
#character-list.horizontal-strip > * {
  scroll-snap-align: unset;
}
.horizontal-strip > * {
  scroll-snap-align: start;
}
.recent-list {
  flex: 1;
}
.character-card,
.recent-card {
  display: grid;
  grid-template-columns: 52px 1fr;
  gap: 11px;
  align-items: start;
  padding: 11px;
  border-radius: 18px;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.045),
    rgba(255, 255, 255, 0.018)
  );
  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}
.character-card:hover,
.recent-card:hover {
  transform: translateY(-2px);
  border-color: rgba(255, 255, 255, 0.16);
  box-shadow: 0 18px 42px rgba(0, 0, 0, 0.24);
}
.character-card.active {
  border-color: rgba(139, 92, 246, 0.65);
  background: linear-gradient(
    180deg,
    rgba(139, 92, 246, 0.22),
    rgba(139, 92, 246, 0.08)
  );
  box-shadow: 0 18px 44px rgba(81, 39, 170, 0.24);
}
.character-card img,
.recent-card img {
  width: 52px;
  height: 52px;
  object-fit: cover;
  border-radius: 14px;
  background: var(--panel-3);
}
.character-card .name,
.recent-card .name {
  font-weight: 700;
  line-height: 1.2;
}
.character-card .desc,
.recent-card .desc,
.meta-line {
  color: var(--muted);
  font-size: 0.9rem;
  line-height: 1.35;
  margin-top: 4px;
}
.card-main {
  min-width: 0;
}
.card-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.favorite-toggle {
  border: 0;
  background: transparent;
  color: var(--muted);
  box-shadow: none;
  padding: 0;
  font-size: 1rem;
}
.favorite-toggle.is-favorite {
  color: #fbbf24;
}

.main-panel {
  display: grid;
  grid-template-rows: minmax(0, 1fr) auto;
  min-width: 0;
  min-height: 0;
  position: relative;
  isolation: isolate;
}
.main-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: var(--chat-bg, none);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  opacity: var(--chat-bg-opacity, 0.14);
  pointer-events: none;
  z-index: 0;
}
.topbar {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  padding: 14px 18px;
  background: rgba(15, 19, 30, 0.72);
  
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 60;
}
.title {
  font-size: 1.28rem;
  font-weight: 800;
  line-height: 1.2;
}
.subtitle {
  color: var(--muted);
  margin-top: 6px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.subtitle .dot {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  display: inline-block;
}
.subtitle .dot.online {
  background: var(--good);
  box-shadow: 0 0 12px rgba(52, 211, 153, 0.6);
}
.subtitle .dot.offline {
  background: var(--bad);
  box-shadow: 0 0 12px rgba(248, 113, 113, 0.35);
}
.topbar-actions {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  color: var(--muted);
}
.field.compact {
  min-width: 220px;
}
.model-picker {
  min-width: 280px;
}
.slim-field span {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}
.select-row {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
}
select,
textarea,
.menu-item,
.profile-button,
#new-chat,
#send-btn,
#close-settings,
input,
.icon-button,
.mini-btn {
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.045);
  color: var(--text);
}
select,
.profile-button,
.menu-item,
#new-chat,
#send-btn,
#close-settings,
input,
.icon-button,
.mini-btn {
  padding: 10px 12px;
}
textarea {
  min-height: 92px;
  max-height: 220px;
  resize: vertical;
  padding: 14px;
  width: 100%;
}
.composer textarea {
  min-height: 52px;
  max-height: 140px;
  padding: 10px 12px;
}
.composer #new-chat,
.composer #send-btn,
.composer .image-upload-button {
  padding: 8px 10px;
}
.icon-button {
  min-width: 44px;
}
#send-btn {
  background: var(--accent);
  border-color: transparent;
  font-weight: 700;
}
.secondary {
  background: transparent;
}
.profile-menu-wrap {
  position: relative;
}
.profile-menu {
  position: absolute;
  right: 0;
  top: calc(100% + 10px);
  width: 280px;
  max-height: calc(100dvh - 100px); /* don't flow off screen if super tall */
  overflow-y: auto;
  background: linear-gradient(
    180deg,
    rgba(26, 31, 44, 0.96),
    rgba(17, 20, 30, 0.96)
  );
  border-radius: 20px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  z-index: 90;
  backdrop-filter: blur(calc(var(--surface-blur) + 4px));
}

.chat-view {
  grid-row: 1;
  overflow-y: auto;
  padding: 28px 24px 120px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  position: relative;
  min-height: 0;
  flex: 1; /* allow growing */
  z-index: 1;
  background: transparent;
  scroll-padding-bottom: 120px;
}
.chat-view::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at top, rgba(139, 92, 246, 0.08), transparent 34%),
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03),
      rgba(255, 255, 255, 0.01)
    );
  pointer-events: none;
  z-index: 0;
}
.chat-view > * {
  position: relative;
  z-index: 1;
}
.empty-state {
  margin: auto;
  max-width: 660px;
  text-align: center;
  color: var(--muted);
  border: 1px dashed var(--border);
  border-radius: 26px;
  padding: 36px;
  background: rgba(255, 255, 255, 0.025);
}
.empty-state h2 {
  color: var(--text);
  margin-top: 0;
}
.empty-actions {
  margin-top: 18px;
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
}
.message-row {
  display: flex;
  gap: 12px;
  align-items: flex-end;
}
.message-row.user {
  justify-content: flex-end;
}
.avatar-bubble {
  width: 36px;
  height: 36px;
  border-radius: 12px;
  object-fit: cover;
  border: 1px solid var(--border);
  background: var(--panel-3);
}
.message-wrap {
  max-width: min(760px, 90%);
}
@media (max-width: 980px) {
  .message-wrap {
    max-width: 85%;
  }
  .message-row {
    gap: 8px;
  }
  .avatar-bubble {
    width: 32px;
    height: 32px;
  }
  .message {
    padding: 12px 14px;
    font-size: 0.95rem;
  }
}
.message-name {
  color: var(--muted);
  font-size: 0.8rem;
  margin: 0 0 4px 2px;
}
.message {
  padding: 14px 16px;
  border-radius: 20px;
  line-height: 1.45;
  white-space: pre-wrap;
}
.message.user {
  background: linear-gradient(
    180deg,
    color-mix(in srgb, var(--accent) 92%, white 8%),
    var(--accent)
  );
  color: white;
  box-shadow: 0 12px 28px rgba(139, 92, 246, 0.22);
}
.message.assistant {
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.06),
    rgba(255, 255, 255, 0.03)
  );
  
}
.message.system {
  background: rgba(255, 255, 255, 0.025);
  color: var(--muted);
  border-style: dashed;
}
.message-enter {
  animation: fadeSlideUp 0.22s ease both;
}
.message-images {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 8px;
}
.message-images img {
  width: 140px;
  height: 140px;
  object-fit: cover;
  border-radius: 16px;
  border: 1px solid var(--border);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.22);
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease;
}
.message-images img:hover {
  transform: translateY(-2px) scale(1.01);
  box-shadow: 0 16px 34px rgba(0, 0, 0, 0.28);
}
.composer {
  grid-row: 2;
  display: grid;
  grid-template-columns: auto auto minmax(0, 1fr) auto;
  gap: 8px;
  padding: 10px 12px;
  background: linear-gradient(
    180deg,
    rgba(16, 20, 30, 0.98),
    rgba(12, 15, 24, 0.98)
  );
  backdrop-filter: blur(calc(var(--surface-blur) + 4px));
  border-top: 1px solid var(--border);
  box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.28);
  align-items: end;
  padding-bottom: max(10px, env(safe-area-inset-bottom));
  position: relative;
  z-index: 5;
}

.composer textarea {
  min-width: 0;
  width: 100%;
  margin: 0;
}

.composer #new-chat,
.composer .image-upload-button,
.composer #send-btn {
  align-self: end;
  min-height: 42px;
}

.character-panel {
  border-left: 1px solid var(--border);
  background: rgba(13, 17, 26, calc(var(--surface-alpha) + 0.08));
  backdrop-filter: blur(var(--surface-blur));
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.app-shell:not(.panel-open) .character-panel {
  border-left: none;
}
.character-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 18px;
  border-bottom: 1px solid var(--border);
}
.character-panel-header h2 {
  margin: 0;
}
.character-panel-content {
  padding: 18px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.character-hero {
  width: 100%;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  border-radius: 24px;
  border: 1px solid var(--border);
}
.info-card {
  border-radius: 20px;
  padding: 15px;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.03),
    rgba(255, 255, 255, 0.018)
  );
}
.info-card h3 {
  margin: 0;
  font-size: 1rem;
}
.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}
.section-head-split {
  align-items: center;
}
.overview-grid {
  display: grid;
  gap: 14px;
  grid-template-columns: 1fr;
  margin-top: 12px;
}
.conversation-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.conversation-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 12px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.025);
  transition:
    transform 0.18s ease,
    border-color 0.18s ease,
    background 0.18s ease;
}
.conversation-item:hover {
  transform: translateY(-1px);
  border-color: rgba(255, 255, 255, 0.14);
}
.conversation-item.active {
  border-color: rgba(139, 92, 246, 0.65);
  background: rgba(139, 92, 246, 0.12);
}
.conversation-copy {
  min-width: 0;
  flex: 1;
}
.conversation-copy .name {
  font-weight: 700;
}
.conversation-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.mini-btn {
  padding: 8px 10px;
  font-size: 0.84rem;
}
.mini-btn.danger {
  color: #fca5a5;
}
.background-thumb-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}
.bg-option {
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  background: var(--panel-3);
  padding: 0;
  text-align: left;
}
.bg-option img {
  width: 100%;
  height: 92px;
  object-fit: cover;
  display: block;
}
.bg-option span {
  display: block;
  padding: 10px;
  font-size: 0.84rem;
  color: var(--muted);
  min-height: 50px;
}
.bg-option.active {
  border-color: rgba(139, 92, 246, 0.72);
  box-shadow:
    inset 0 0 0 1px var(--accent),
    0 10px 32px rgba(0, 0, 0, 0.18);
}
.bg-favorite {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 34px;
  height: 34px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.15);
  background: rgba(0, 0, 0, 0.45);
  color: white;
  box-shadow: none;
}
.bg-favorite.active {
  color: #fbbf24;
}
.wide-btn {
  width: 100%;
}
.floating-profile-wrap {
  position: fixed;
  top: 14px;
  right: 16px;
  z-index: 75;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
}
.floating-title,
.floating-status {
  display: none;
}
.floating-profile-button {
  background: rgba(24, 29, 41, calc(var(--surface-alpha) + 0.08));
  backdrop-filter: blur(var(--surface-blur));
}
.drawer-handle {
  position: fixed;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  width: 28px;
  height: 92px;
  border-radius: 999px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(var(--surface-blur));
  z-index: 72;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.22);
  transition:
    transform 0.22s ease,
    background 0.22s ease,
    opacity 0.22s ease;
  opacity: 0.78;
}
.drawer-handle:hover {
  background: rgba(255, 255, 255, 0.14);
  opacity: 1;
  box-shadow: 0 18px 38px rgba(0, 0, 0, 0.28);
}
.drawer-handle.open {
  transform: translateY(-50%) rotate(180deg);
}
.avatar-preview-wrap {
  display: flex;
  justify-content: center;
}
.avatar-preview {
  width: 112px;
  height: 112px;
  object-fit: cover;
  border-radius: 22px;
  border: 1px solid var(--border);
  background: var(--panel-3);
}
.dialog-inline-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.import-btn {
  position: relative;
  overflow: hidden;
}
.advanced-override {
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 12px;
  background: rgba(255, 255, 255, 0.02);
}
.advanced-override summary {
  cursor: pointer;
  color: var(--text);
  font-weight: 700;
  margin-bottom: 10px;
}
.advanced-override[open] {
  animation: fadeSlideUp 0.18s ease both;
}
.tag-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 12px;
}
.tag-pill {
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(139, 92, 246, 0.12);
  border: 1px solid rgba(139, 92, 246, 0.3);
  color: #ddd6fe;
  font-size: 0.8rem;
}
button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.image-upload-button {
  font-weight: 700;
  letter-spacing: 0.01em;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

dialog {
  width: min(700px, calc(100vw - 32px));
  border-radius: 28px;
  background: linear-gradient(
    180deg,
    rgba(27, 32, 45, 0.98),
    rgba(18, 22, 33, 0.98)
  );
  color: var(--text);
  padding: 0;
  box-shadow: 0 28px 70px rgba(0, 0, 0, 0.42);
}
.user-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.user-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 14px;
  background: rgba(255, 255, 255, 0.03);
}
.user-card .name {
  font-weight: 700;
}
.user-card .desc {
  color: var(--muted);
  font-size: 0.9rem;
  margin-top: 4px;
}
.user-actions {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
}
dialog::backdrop {
  background: rgba(0, 0, 0, 0.55);
}
body.compact-ui .character-card,
body.compact-ui .recent-card,
body.compact-ui .info-card,
body.compact-ui .composer {
  padding: 10px;
}
body.reduce-motion *,
body.reduce-motion *::before,
body.reduce-motion *::after {
  transition: none !important;
  animation: none !important;
  scroll-behavior: auto !important;
}
.settings-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 22px;
  border-bottom: 1px solid var(--border);
}
.settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  padding: 18px 22px 22px;
}
.single-column-form {
  grid-template-columns: 1fr;
}
.dialog-actions {
  display: flex;
  justify-content: flex-end;
}
.dialog-actions button {
  padding: 12px 16px;
  border-radius: 14px;
  background: var(--accent);
  color: white;
  border: 0;
}

body[data-animation="high"] .character-card,
body[data-animation="high"] .recent-card,
body[data-animation="high"] .conversation-item,
body[data-animation="high"] .bg-option,
body[data-animation="high"] .profile-button,
body[data-animation="high"] .mini-btn,
body[data-animation="high"] .drawer-handle {
  transition-duration: 0.28s;
}
body[data-animation="low"] .character-card,
body[data-animation="low"] .recent-card,
body[data-animation="low"] .conversation-item,
body[data-animation="low"] .bg-option,
body[data-animation="low"] .profile-button,
body[data-animation="low"] .mini-btn,
body[data-animation="low"] .drawer-handle {
  transition-duration: 0.12s;
}

@media (max-width: 1280px) {
  .app-shell {
    grid-template-columns: 260px minmax(0, 1fr);
  }
  .app-shell:not(.panel-open) {
    grid-template-columns: 260px minmax(0, 1fr);
  }
  .character-panel {
    position: fixed;
    top: 0;
    right: 0;
    width: min(400px, 96vw);
    height: 100dvh;
    z-index: 40;
    box-shadow: -20px 0 44px rgba(0, 0, 0, 0.38);
    transition: transform 0.2s ease;
  }
  .app-shell:not(.panel-open) .character-panel {
    transform: translateX(100%);
  }
  .app-shell.panel-open .character-panel {
    transform: translateX(0);
  }
}

@media (max-width: 980px) {
  .app-shell {
    grid-template-columns: 1fr;
  }
  .app-shell:not(.panel-open) {
    grid-template-columns: 1fr;
  }
  .main-panel {
    grid-column: 1;
    height: 100dvh;
    min-height: 100dvh;
  }
  .character-panel {
    grid-column: 1;
  }
  .mobile-only {
    display: inline-flex;
  }
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: min(320px, 90vw);
    height: 100dvh;
    z-index: 45;
    transform: translateX(-100%);
    transition: transform 0.2s ease;
  }
  .app-shell.library-open .sidebar,
  .app-shell.left-open .sidebar {
    transform: translateX(0);
  }
  .library-hub {
    position: fixed;
    inset: 0;
    height: 100dvh;
    padding: calc(max(16px, env(safe-area-inset-top)) + 56px) 16px
      max(16px, env(safe-area-inset-bottom));
    z-index: 70;
  }
  .floating-profile-wrap {
    top: max(8px, env(safe-area-inset-top));
    left: auto;
    right: max(10px, env(safe-area-inset-right));
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    z-index: 75;
    padding: 0;
  }
  .floating-title {
    display: none;
  }
  .floating-status {
    display: none;
  }
  .floating-profile-button {
    width: auto;
    min-width: 0;
  }
  .app-shell:not(.library-collapsed) .library-backdrop {
    opacity: 0;
    pointer-events: none;
  }
  .app-shell.library-open .library-backdrop {
    opacity: 1;
    pointer-events: auto;
  }
  .library-hub-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .library-hub-header .section-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
    margin-top: 4px;
  }
  .filter-row {
    grid-template-columns: 1fr;
    display: grid;
    gap: 12px;
  }
  .section-actions {
    flex-wrap: wrap;
  }
  .horizontal-strip {
    grid-auto-columns: minmax(240px, 85vw);
  }
  #character-list.horizontal-strip {
    grid-template-columns: 1fr;
  }
  .field.compact,
  .model-picker {
    min-width: 0;
  }
  .topbar {
    flex-direction: column;
    align-items: stretch;
  }
  .topbar-actions {
    width: 100%;
    justify-content: stretch;
  }
  .topbar-actions > * {
    flex: 1 1 220px;
  }
  .composer {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    grid-template-columns: auto auto 1fr auto;
    grid-template-areas: "input input input input" "new upload void send";
    align-items: center;
    column-gap: 8px;
    row-gap: 8px;
    padding: 8px 12px calc(10px + env(safe-area-inset-bottom));
    background: rgba(13, 17, 26, 0.99);
    backdrop-filter: blur(calc(var(--surface-blur) + 6px));
    border-top: 1px solid var(--border);
    box-shadow: 0 -14px 34px rgba(0, 0, 0, 0.34);
    z-index: 90;
  }
  .composer #new-chat,
  .composer .image-upload-button {
    display: inline-flex;
    width: auto;
    height: 48px;
    min-height: 48px;
    padding: 0 16px;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.06);
  }
  .composer #new-chat {
    grid-area: new;
  }
  .composer .image-upload-button {
    grid-area: upload;
  }
  .composer textarea {
    grid-area: input;
    width: 100%;
    min-height: 46px;
    max-height: 100px;
    padding: 12px 14px;
    border-radius: 18px;
    font-size: 16px;
    line-height: 1.35;
    align-self: stretch;
    margin: 0;
  }
  .composer #send-btn {
    grid-area: send;
    width: 48px;
    height: 48px;
    min-height: 48px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    font-size: 0;
    background: var(--accent);
    color: white;
    border-color: transparent;
    box-shadow: 0 10px 24px rgba(139, 92, 246, 0.28);
  }
  .composer #send-btn::after {
    content: "↑";
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1;
  }
  /* keep the last message visible above the fixed composer */
  .chat-view {
    padding-bottom: calc(160px + env(safe-area-inset-bottom));
    scroll-padding-bottom: calc(160px + env(safe-area-inset-bottom));
  }
  .character-panel {
    width: min(420px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    right: 0;
  }
  .drawer-handle {
    top: auto;
    bottom: calc(max(72px, env(safe-area-inset-bottom) + 56px));
    right: max(14px, env(safe-area-inset-right));
    transform: none;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    opacity: 0.92;
    z-index: 80;
  }
  .drawer-handle.open {
    transform: rotate(180deg);
  }
  .settings-grid {
    grid-template-columns: 1fr;
  }
}

@media (hover: none) {
  .hover-preview {
    display: none;
  }
  .character-card:hover,
  .recent-card:hover,
  .message-images img:hover,
  button:hover {
    transform: none;
    box-shadow: inherit;
  }
}

/* Mobile performance pass: phones struggle with layered blur/shadow/animation. */
@media (max-width: 980px) {
  body {
    background: linear-gradient(180deg, #0b0d13, #101421 60%, #0d1018);
  }

  .sidebar,
  .character-panel,
  .topbar,
  .composer,
  .profile-menu,
  dialog,
  .info-card,
  .character-card,
  .recent-card,
  .message.assistant,
  .message.system,
  .library-hub,
  .library-backdrop {
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .character-card,
  .recent-card,
  .message,
  .composer,
  .topbar,
  .sidebar,
  .character-panel,
  .profile-menu,
  dialog,
  select,
  textarea,
  input,
  button {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    box-shadow: none;
  }

  .message-enter {
    animation: none !important;
  }
  .chat-view::before {
    display: none;
  }
  .main-panel::before {
    opacity: calc(var(--chat-bg-opacity, 0.14) * 0.65);
  }
  .message.assistant {
    background: rgba(255, 255, 255, 0.045);
  }
  .message.user {
    box-shadow: none;
  }
  .horizontal-strip {
    scroll-snap-type: none;
  }
  .hover-preview {
    display: none;
  }
}

/* Global performance pass: keep layout intact while reducing repaint-heavy effects. */
button,
.character-card,
.recent-card,
.message-images img,
.tab-chip,
.menu-item,
.icon-button,
.profile-button {
  transition-duration: 0.08s;
}

.message-enter {
  animation-duration: 0.12s;
}

.message.assistant,
.message.system,
.library-backdrop,
.library-hub,
.sidebar,
.character-panel,
.topbar,
.composer,
.profile-menu,
dialog {
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

.character-card:hover,
.recent-card:hover,
.character-card.active,
.message.user,
.message-images img,
.drawer-handle,
dialog,
.auth-card {
  box-shadow: none;
}

.chat-view::before {
  opacity: 0.65;
}

.chat-input-wrapper:focus-within {
  border-color: rgba(215, 181, 254, 0.5);
}

.modal-content input:focus, .modal-content textarea:focus { border-color: var(--primary-brand); outline: none; }
